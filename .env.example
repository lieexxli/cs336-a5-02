# Copy this file to `.env` and replace the placeholder values.
# The repository will auto-load `.env` for both training path overrides
# and DeepSeek-based supplemental judges.

# Leave blank to use repository defaults.
CS336_ALIGNMENT_DATA_DIR=
CS336_ALIGNMENT_OUTPUT_DIR=
CS336_ALIGNMENT_MODEL=Qwen/Qwen2.5-Math-1.5B

DEEPSEEK_API_KEY=replace-with-your-key
OPENAI_API_KEY=${DEEPSEEK_API_KEY}
OPENAI_BASE_URL=https://api.deepseek.com
CS336_ALIGNMENT_JUDGE_MODEL=deepseek-chat
